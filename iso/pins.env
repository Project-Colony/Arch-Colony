# Inputs the ISO build downloads from outside this repository, pinned so that a
# given commit of Arch Colony always builds from the same bytes. Read by
# iso/fetch-inputs.sh, which iso/build.sh and .github/workflows/ci.yml both run,
# so CI checks exactly what the next image will be built from.
#
# To move a pin, change the commit and, for themes.json, its sha256 with it:
#   curl -fsSL https://raw.githubusercontent.com/Project-Colony/Project-Colony-Resources/<commit>/generated/themes.json | sha256sum

# archinstall 4.5: the desktop and driver definitions tools/gen-netinstall.py
# turns into the installer's package page.
ARCHINSTALL_COMMIT=78982a624824aa415f59bf88c515676a589e3c55

# Project-Colony-Resources main on 2026-10-09: generated/themes.json, the palette
# tools/resolve-theme.py fills the installer's templates from.
RESOURCES_COMMIT=807d17bbc090adba77b63287f2b446f4ccdfc67b
THEMES_SHA256=10f0e9d9fc8373695e248f5fc6d20490c27c243a84c0a3e848f02fcefb805800

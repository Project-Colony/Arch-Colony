[Unit]
Description=Apply the boot entry's language, font and text size to the live session
# Before any login, so that the console, the message of the day and the
# installer all start in it, and before the screen reader starts speaking.
Before=systemd-user-sessions.service livecd-talk.service espeakup.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/colony-live-setup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

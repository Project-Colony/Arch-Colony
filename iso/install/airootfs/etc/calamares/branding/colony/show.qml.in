// Arch Colony installer slideshow — a template: every colour is a field of
// the Colony palette, filled in at ISO build time (tools/resolve-theme.py).
import QtQuick 2.0;
import calamares.slideshow 1.0;

Presentation
{
    id: presentation

    Slide {
        Rectangle {
            anchors.fill: parent
            color: "@bg_primary@"
        }

        Image {
            id: logo
            source: "logo.png"
            width: 160; height: 160
            fillMode: Image.PreserveAspectFit
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.verticalCenter: parent.verticalCenter
            anchors.verticalCenterOffset: -70
        }

        Rectangle {
            id: rule
            width: 48; height: 3; radius: 1.5
            color: "@accent_blue@"
            anchors.horizontalCenter: logo.horizontalCenter
            anchors.top: logo.bottom
            anchors.topMargin: 24
        }

        Text {
            id: title
            text: "Arch Colony"
            color: "@text_primary@"
            font.pixelSize: 26
            font.bold: true
            anchors.horizontalCenter: logo.horizontalCenter
            anchors.top: rule.bottom
            anchors.topMargin: 18
        }

        Text {
            anchors.horizontalCenter: logo.horizontalCenter
            anchors.top: title.bottom
            anchors.topMargin: 12
            horizontalAlignment: Text.AlignHCenter
            wrapMode: Text.WordWrap
            width: presentation.width * 0.7
            color: "@text_secondary@"
            font.pixelSize: 15
            lineHeight: 1.25
            text: "Arch Linux — mêmes dépôts, mêmes miroirs, même rythme de mise à jour.<br/>" +
                  "Plus une couche : noyau durci, pare-feu applicatif, " +
                  "et les programmes de l'écosystème Colony."
        }
    }
}

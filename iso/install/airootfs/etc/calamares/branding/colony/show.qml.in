// Arch Colony installer slideshow - a template: every colour is a field of
// the Colony palette, filled in at ISO build time (tools/resolve-theme.py).
import QtQuick 2.0;
import calamares.slideshow 1.0;

Presentation
{
    id: presentation

    // The slideshow's text, one object per language with the same keys;
    // tools/check-i18n.py fails CI when they differ. Calamares starts in the
    // boot entry's language (colony.lang, through LANG), and that is what
    // Qt.locale() reports here: Calamares never changes the default QLocale, so
    // a language picked later on the welcome page does not reach this view.
    readonly property var en: ({
        tagline: "Arch Linux: the same repositories, the same mirrors, the same update pace.<br/>" +
                 "Plus one layer: a hardened kernel, an application firewall, " +
                 "and the programs of the Colony ecosystem."
    })
    readonly property var fr: ({
        tagline: "Arch Linux : mêmes dépôts, mêmes miroirs, même rythme de mise à jour.<br/>" +
                 "Plus une couche : noyau durci, pare-feu applicatif, " +
                 "et les programmes de l'écosystème Colony."
    })
    readonly property var strings: Qt.locale().name.substring(0, 2) === "fr" ? fr : en

    // The view is larger than a Slide, and its default clear colour is white:
    // seen as a white frame around the first themed image (2026-09-05). The
    // ground belongs on the root, which Calamares sizes to the whole view.
    Rectangle {
        anchors.fill: parent
        color: "@bg_primary@"
        z: -1
    }

    // Type. No font is named here: the text is in the installer's font, which
    // the boot entry chose through fontconfig (JetBrainsMono Nerd Font, or
    // OpenDyslexic with colony.font=dyslexic). Sizes are the design system's
    // base sizes in logical pixels: the boot entry's text scale
    // (colony.textscale) reaches this view as QT_SCALE_FACTOR, which Qt applies
    // here and to every widget around it at once, so multiplying here as well
    // would apply it twice.
    //
    // Laid out as one centred column whose logo gives way first, so that the
    // text still fits at the largest scale on a small screen, and in French,
    // which runs longer.
    Slide {
        Column {
            anchors.centerIn: parent
            width: presentation.width * 0.7
            spacing: 18

            Image {
                id: logo
                source: "logo.png"
                width: height
                height: Math.max(48, Math.min(160,
                    presentation.height - rule.height - title.height - tagline.height - 3 * parent.spacing - 48))
                fillMode: Image.PreserveAspectFit
                anchors.horizontalCenter: parent.horizontalCenter
            }

            Rectangle {
                id: rule
                width: 48; height: 3; radius: 1.5
                color: "@accent_blue@"
                anchors.horizontalCenter: parent.horizontalCenter
            }

            Text {
                id: title
                text: "Arch Colony"
                color: "@text_primary@"
                font.pixelSize: 26
                font.bold: true
                anchors.horizontalCenter: parent.horizontalCenter
            }

            Text {
                id: tagline
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                color: "@text_secondary@"
                font.pixelSize: 15
                lineHeight: 1.25
                text: presentation.strings.tagline
            }
        }
    }
}

# Arch Colony installer branding — a template.
#
# No colour is written in this repository (principe 4). The four the sidebar
# needs are named below as palette fields (@bg_sidebar@, ...) and filled in by
# iso/build.sh from Project-Colony-Resources' generated/themes.json, through
# tools/resolve-theme.py. The rest of the installer is styled the same way by
# stylesheet.qss.in next to this file, which Calamares loads as stylesheet.qss.
#
# logo.png is vendored from Colony/assets/icons/icon.png for the same reason it is
# a problem: shared assets belong in Project-Colony-Resources, and there is no asset
# target there yet. Replace this copy with a generated one when there is.
---
componentName: colony

welcomeStyleCalamares: true
welcomeExpandingLogo:  true
windowExpanding:       normal
windowSize:            900px,560px
windowPlacement:       center
sidebar:               widget
navigation:            widget

strings:
    productName:         "Arch Colony"
    shortProductName:    "Arch Colony"
    version:             "rolling"
    shortVersion:        "rolling"
    versionedName:       "Arch Colony"
    shortVersionedName:  "Arch Colony"
    bootloaderEntryName: "Arch Colony"
    productUrl:          "https://github.com/Project-Colony/Arch-Colony"
    supportUrl:          "https://github.com/Project-Colony/Arch-Colony/tree/main/docs"
    knownIssuesUrl:      "https://github.com/Project-Colony/Arch-Colony/issues"

images:
    productIcon:    "logo.png"
    productLogo:    "logo.png"
    productWelcome: "logo.png"

# Not optional. Omitting it makes Calamares fail to start outright:
#   WARNING: YAML error  key not found: slideshow in ".../branding.desc"
#   ERROR: FATAL in ".../branding.desc"
slideshow:    "show.qml"
slideshowAPI: 2

# Also not optional — omitting the block is fatal:
#   WARNING: YAML error  invalid node; first invalid key: "style"
#
# These four are the only colours Calamares 3.4 reads from this file: the step
# list in the widget sidebar. The current step is drawn inverted on the family
# accent; the others sit in the secondary text tone, so the current one reads
# as the current one.
style:
    SidebarBackground:        "@bg_sidebar@"
    SidebarText:              "@text_secondary@"
    SidebarBackgroundCurrent: "@accent_blue@"
    SidebarTextCurrent:       "@bg_primary@"

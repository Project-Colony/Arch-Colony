# Maintainer: MotherSphere <linhajahad@gmail.com>

pkgname=colony-mirrorlist
pkgver=20260819
pkgrel=2
pkgdesc='Arch Colony repository mirrorlist'
arch=('any')
url='https://github.com/Project-Colony/Arch-Colony'
license=('GPL-3.0-or-later')
backup=('etc/pacman.d/colony-mirrorlist')
source=('colony-mirrorlist' 'colony-repo.conf')
sha256sums=('SKIP' 'SKIP')

package() {
	install -Dm644 colony-mirrorlist "$pkgdir/etc/pacman.d/colony-mirrorlist"

	# The [colony] stanza, as a fragment rather than as /etc/pacman.conf itself:
	# that file belongs to the `pacman` package, and shipping our own would shadow
	# a base package (ADR-0002) and conflict on install. The installer appends this
	# to the target's pacman.conf instead.
	#
	# Appended at the end rather than inserted before [core]. Position carries no
	# functional weight here precisely because ADR-0002 guarantees no package in
	# [colony] shares a name with one in core/extra/multilib — there is nothing for
	# an earlier declaration to win. Inserting mid-file would mean editing a
	# user-editable config with a regex, which is how installers corrupt pacman.conf.
	install -Dm644 colony-repo.conf "$pkgdir/usr/share/colony/pacman/colony-repo.conf"
}

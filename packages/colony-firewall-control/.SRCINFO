pkgbase = colony-firewall-control
	pkgver = 0.2.2
	pkgrel = 1
	url = https://github.com/Project-Colony/Colony-Firewall-Control
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = rust
	makedepends = rust-src
	makedepends = bpf-linker
	makedepends = protobuf
	options = !lto
	source = colony-firewall-control-0.2.2.tar.gz::https://github.com/Project-Colony/Colony-Firewall-Control/archive/refs/tags/v0.2.2.tar.gz
	sha256sums = aa7ddcd519a89bb42662b0584b68ec3e3e86d1dbb289092b2a6633061813d7b7

pkgname = colony-firewall-control
	pkgdesc = Per-application firewall for Colony — daemon, CLI and UI
	install = colony-firewall-control.install
	depends = gcc-libs
	depends = glibc
	depends = nftables
	depends = libxkbcommon
	depends = wayland
	depends = hicolor-icon-theme
	depends = colony-firewall-control-ebpf=0.2.2-1
	optdepends = libnotify: desktop notifications on new prompts
	optdepends = libx11: run the GUI in X11/XWayland sessions
	backup = etc/colony-firewall/daemon.toml

pkgname = colony-firewall-control-ebpf
	pkgdesc = Colony Firewall Control — kernel-side eBPF object
	options = !strip
	options = !debug
	options = !lto

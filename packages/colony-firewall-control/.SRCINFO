pkgbase = colony-firewall-control
	pkgver = 0.8.0
	pkgrel = 1
	url = https://github.com/Project-Colony/Colony-Firewall-Control
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = rust
	makedepends = rust-src
	makedepends = bpf-linker
	makedepends = protobuf
	options = !lto
	source = colony-firewall-control-0.8.0.tar.gz::https://github.com/Project-Colony/Colony-Firewall-Control/archive/refs/tags/v0.8.0.tar.gz
	sha256sums = f35da98261ab05e9ed31958048627c496785d46f6b8292e603a0080e7f93554d

pkgname = colony-firewall-control
	pkgdesc = Per-application firewall for Colony: daemon, CLI and UI
	install = colony-firewall-control.install
	depends = gcc-libs
	depends = glibc
	depends = nftables
	depends = libxkbcommon
	depends = wayland
	depends = hicolor-icon-theme
	depends = colony-firewall-control-ebpf=0.8.0-1
	optdepends = bubblewrap>=0.13.0: explicit headless application confinement
	optdepends = libbpf: mandatory interface filters for application confinement
	optdepends = libnotify: desktop notifications on new prompts
	optdepends = libx11: run the GUI in X11/XWayland sessions
	optdepends = polkit: administrator prompt when the app or tray pauses filtering or imports rules
	backup = etc/colony-firewall/daemon.toml

pkgname = colony-firewall-control-ebpf
	pkgdesc = Colony Firewall Control: kernel-side eBPF object
	options = !strip
	options = !debug
	options = !lto

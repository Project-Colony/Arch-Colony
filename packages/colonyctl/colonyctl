#!/usr/bin/env bash
# colonyctl - the front door to an Arch Colony system.
#
# It delegates. `colonyctl update` is `pacman -Syu`, and that is the whole
# design: [colony] is an ordinary pacman repository, so Colony packages arrive
# through pacman exactly as Arch's do. A command that did anything else would be
# a fork wearing a derivative's clothes (ADR-0001).
#
# Deliberately NOT pacman's grammar. `colonyctl -Syu` would promise that -S, -R,
# -Q and -U work too, and every gap becomes a support trap. None of the five
# Arch derivatives surveyed imitates those flags; they all use verbs or long
# options, and so does this.
#
# Deliberately thin, too. Other wrappers rewrite mirrorlists, inject --ignore,
# auto-answer pacman's prompts, split -Syu into -Sy then -Su, or fetch and
# execute a remote script as root. Each of those turns "my package manager
# behaved oddly" into a question only this tool can answer. Anything that must
# happen on upgrade belongs in an alpm hook, which fires under pacman, paru and
# this script alike - a wrapper nobody remembers to type protects nobody.

set -uo pipefail

PROGRAM=${0##*/}
VERSION=@VERSION@

# Every message comes from a string table, in English or French after LANG. The
# English one is read first, so a French string that is missing shows in
# English rather than as nothing. tools/check-i18n.py keeps the keys identical.
STRINGS=${COLONYCTL_STRINGS:-/usr/share/colonyctl/strings}
# shellcheck source=packages/colonyctl/en.sh
. "$STRINGS/en.sh"
case ${LC_ALL:-${LC_MESSAGES:-${LANG:-}}} in
	fr*)
		# shellcheck source=packages/colonyctl/fr.sh
		. "$STRINGS/fr.sh"
		;;
esac

# NO_COLOR is honoured, and so is a non-tty: this gets piped into bug reports.
if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
	B=$'\e[1m'; DIM=$'\e[2m'; OK=$'\e[32m'; WARN=$'\e[33m'; BAD=$'\e[31m'; R=$'\e[0m'
else
	B=''; DIM=''; OK=''; WARN=''; BAD=''; R=''
fi

die() { printf '%s: %s\n' "$PROGRAM" "$*" >&2; exit 1; }
# shellcheck disable=SC2059 # the format is a translated message
fmt() { local f=$1; shift; printf "$f" "$@"; }

# Re-exec through sudo rather than requiring the whole command to be run as
# root: it keeps $HOME and the user's paru configuration intact.
as_root() {
	if (( EUID == 0 )); then
		"$@"
	else
		command -v sudo >/dev/null || die "$msg_no_sudo"
		sudo "$@"
	fi
}

# Padded by characters, not bytes, and wide enough for the French labels: printf
# would count an accented letter twice and pull its value one column left.
field() {
	local pad=$(( 31 - ${#1} ))
	(( pad > 0 )) || pad=1
	printf '  %s%*s%s\n' "$1" "$pad" '' "$2"
}

usage() {
	cat <<EOF
${B}$PROGRAM${R} - $msg_usage_title

  ${B}$PROGRAM update${R} [--aur]     $msg_usage_update
  ${B}$PROGRAM status${R}             $msg_usage_status
  ${B}$PROGRAM firewall${R} <args…>   $msg_usage_firewall
  ${B}$PROGRAM version${R}
  ${B}$PROGRAM help${R}

${DIM}$msg_usage_note${R}
EOF
}

cmd_update() {
	local aur=0
	while (( $# )); do
		case $1 in
			--aur) aur=1 ;;
			-h|--help) usage; return 0 ;;
			-S*|-R*|-Q*|-U*|-y*|-u*)
				die "$(fmt "$msg_pacman_option" "$1" "$PROGRAM")"
				;;
			*) die "$(fmt "$msg_unknown_option" "$1" "$PROGRAM")" ;;
		esac
		shift
	done

	# -Syu in one transaction. Never -Sy on its own, and never -Sy followed by a
	# separate -Su: that is a partial upgrade, the one thing Arch asks everyone
	# not to do, and wrappers reproduce it surprisingly often.
	echo "${B}==>${R} pacman -Syu"
	as_root pacman -Syu || return $?

	if (( aur )); then
		command -v paru >/dev/null || die "$msg_aur_needs_paru"
		echo
		echo "${B}==>${R} paru -Sua"
		# Not as_root: paru builds as the invoking user and asks for privilege
		# itself. Running it as root is refused by paru anyway.
		paru -Sua || return $?
	fi
}

cmd_status() {
	local v
	echo "${B}$msg_section_system${R}"
	if [[ -r /etc/os-release ]]; then
		# shellcheck disable=SC1091
		v=$(. /etc/os-release && printf '%s' "${PRETTY_NAME:-$NAME}")
		field "$msg_distribution" "$v"
	fi
	field "$msg_kernel" "$(uname -r)"

	echo
	echo "${B}$msg_section_packages${R}"
	if pacman-conf --repo-list 2>/dev/null | grep -qx colony; then
		field "[colony]" "${OK}$msg_configured${R}"
		# Reachability, not just configuration. A declared repository that
		# cannot be synchronised breaks every pacman -Syu on the machine, so it
		# is worth saying out loud before the user discovers it mid-upgrade.
		local server
		server=$(pacman-conf --repo=colony Server 2>/dev/null | head -n1)
		[[ -n $server ]] && field "$msg_server" "$server"
		# Whether a colony.db served without its signature would be refused.
		# pacman-conf prints nothing for a section without its own SigLevel,
		# so fall back to [options] as pacman does - and the [options] that
		# `pacman` ships says DatabaseOptional. When the section sets one,
		# pacman-conf already prints it merged with [options].
		local sig
		sig=$(pacman-conf --repo=colony SigLevel 2>/dev/null)
		[[ -n $sig ]] || sig=$(pacman-conf SigLevel 2>/dev/null)
		if grep -qx DatabaseRequired <<<"$sig"; then
			field "$msg_db_signature" "${OK}$msg_required${R}"
		else
			field "$msg_db_signature" "${BAD}$msg_not_required${R}"
		fi
	else
		field "[colony]" "${WARN}$msg_not_configured${R}"
	fi
	local n
	n=$(pacman -Qq 2>/dev/null | wc -l)
	field "$msg_installed" "$(fmt "$msg_package_count" "$n")"

	echo
	echo "${B}$msg_section_enforcement${R}"
	# The list the kernel actually has, not the one we hoped for.
	if [[ -r /sys/kernel/security/lsm ]]; then
		field "$msg_kernel_lsms" "$(< /sys/kernel/security/lsm)"
	fi
	# Written out rather than as `test && field || field`: that chain quietly
	# runs the second branch whenever the first command fails for its own
	# reasons, which is a trap worth not laying in a status display.
	if [[ -d /sys/kernel/security/apparmor ]]; then
		field "AppArmor" "${OK}$msg_active${R}"
	else
		field "AppArmor" "${DIM}$msg_not_active${R}"
	fi
	if [[ -d /sys/fs/selinux ]]; then
		field "SELinux" "${OK}$msg_active${R}"
	else
		field "SELinux" "${DIM}$msg_not_active${R}"
	fi

	echo
	echo "${B}$msg_section_session${R}"
	# Added because diagnosing "I picked a desktop and got a text console"
	# otherwise means typing a wall of systemctl into a VM with no clipboard.
	# Everything here is one line of output somebody would otherwise have to ask
	# for, and the three of them together identify the failure on their own.
	local target
	target=$(systemctl get-default 2>/dev/null)
	if [[ $target == graphical.target ]]; then
		field "$msg_default_target" "${OK}$target${R}"
	else
		field "$msg_default_target" "${BAD}${target:-$msg_unknown}${R} - $msg_no_greeter_will_start"
	fi
	# The symlink is the truth: `systemctl enable` on a display manager rewrites
	# it, so with two desktops installed it names whichever won.
	if [[ -L /etc/systemd/system/display-manager.service ]]; then
		local dm
		dm=$(basename "$(readlink /etc/systemd/system/display-manager.service)")
		if systemctl is-active --quiet display-manager 2>/dev/null; then
			field "$msg_display_manager" "${OK}$(fmt "$msg_dm_running" "$dm")${R}"
		else
			field "$msg_display_manager" "${WARN}$(fmt "$msg_dm_not_running" "$dm")${R}"
		fi
	else
		field "$msg_display_manager" "${BAD}$msg_dm_none${R}"
	fi
	local greeters
	greeters=$(pacman -Qq 2>/dev/null | grep -xE 'sddm|gdm|lightdm|greetd|ly|cosmic-greeter|plasma-login-manager' | tr '\n' ' ')
	field "$msg_greeters_installed" "${greeters:-${DIM}$msg_none${R}}"
	local failed
	failed=$(systemctl --failed --no-legend --no-pager --plain 2>/dev/null | awk '{print $1}' | tr '\n' ' ')
	[[ -n $failed ]] && field "$msg_failed_units" "${BAD}$failed${R}"

	echo
	echo "${B}$msg_section_firewall${R}"
	if ! command -v cfc >/dev/null; then
		# colony-firewall-defaults, not -control: the firewall package alone
		# enables nothing.
		field "Colony Firewall" "${DIM}$msg_firewall_not_installed${R}"
		return 0
	fi
	local daemon=0
	if systemctl is-active --quiet colony-firewalld.service 2>/dev/null; then
		daemon=1
		field "$msg_daemon" "${OK}$msg_running${R}"
	else
		field "$msg_daemon" "${WARN}$msg_stopped${R}"
	fi
	# Since CFC 0.7.0 the table loads on its own, before the daemon, and stays
	# when the daemon dies. Loaded with no daemon behind it, it refuses every new
	# connection outside loopback without a prompt to say why.
	if ! systemctl is-active --quiet colony-firewall-nft.service 2>/dev/null; then
		field "$msg_filtering_table" "${WARN}$msg_not_loaded${R}"
	elif (( daemon )); then
		field "$msg_filtering_table" "${OK}$msg_loaded${R}"
	else
		field "$msg_filtering_table" "${BAD}$msg_loaded_no_daemon${R}"
	fi
	# The kernel object is the whole reason [colony] ships its own build of CFC:
	# the AUR package deliberately omits it, and a daemon without it filters on
	# without its strongest layer and says so only in a log line.
	if [[ -f /usr/lib/colony-firewall/cfc-ebpf.o ]]; then
		field "$msg_kernel_object" "${OK}$msg_present${R}"
	else
		field "$msg_kernel_object" "${BAD}$msg_missing_object${R}"
	fi
	# cfc knows its own enforcement level; ask it rather than guessing.
	echo
	cfc status 2>&1 | sed 's/^/  /'
}

main() {
	(( $# )) || { usage; exit 0; }
	local verb=$1; shift
	case $verb in
		update)          cmd_update "$@" ;;
		status)          cmd_status "$@" ;;
		firewall)
			command -v cfc >/dev/null \
				|| die "$msg_no_firewall"
			exec cfc "$@"
			;;
		version|--version) printf '%s %s\n' "$PROGRAM" "$VERSION" ;;
		help|-h|--help)  usage ;;
		-*)
			die "$(fmt "$msg_pacman_verb" "$verb" "$PROGRAM")"
			;;
		*) die "$(fmt "$msg_unknown_command" "$verb" "$PROGRAM")" ;;
	esac
}

main "$@"

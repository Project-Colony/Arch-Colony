@@ -25,6 +30,50 @@ ErrorDialog::ErrorDialog( QWidget* parent )
     ui->iconLabel->setPixmap( QIcon::fromTheme( "dialog-error" ).pixmap( 64 ) );
     ui->detailsWidget->hide();
     ui->offerWebPasteLabel->hide();
+
+    // ActionRole, so pressing it does not close the dialog.
+    m_logButton = ui->buttonBox->addButton( tr( "Show log", "@button" ), QDialogButtonBox::ActionRole );
+    connect( m_logButton, &QPushButton::clicked, this, &ErrorDialog::showLogTail );
+}
+
+void
+ErrorDialog::appendDetails( const QString& text )
+{
+    // detailsBrowser is a QTextBrowser, so append() would interpret its argument
+    // as rich text — exactly wrong for a log, which is full of angle brackets and
+    // ampersands. Going through plain text keeps it verbatim.
+    const QString existing = ui->detailsBrowser->toPlainText();
+    ui->detailsBrowser->setPlainText( existing.isEmpty() ? text : existing + QLatin1Char( '\n' ) + text );
+}
+
+void
+ErrorDialog::showLogTail()
+{
+    static constexpr int c_tailLines = 200;
+
+    QFile log( Logger::logFile() );
+    if ( !log.open( QIODevice::ReadOnly | QIODevice::Text ) )
+    {
+        appendDetails( tr( "Could not read the log at %1", "@info" ).arg( Logger::logFile() ) );
+        ui->detailsWidget->show();
+        return;
+    }
+
+    QStringList lines;
+    while ( !log.atEnd() )
+    {
+        lines.append( QString::fromUtf8( log.readLine() ).trimmed() );
+        if ( lines.size() > c_tailLines )
+        {
+            lines.removeFirst();
+        }
+    }
+
+    appendDetails( QStringLiteral( "--- %1 ---" ).arg( Logger::logFile() ) );
+    appendDetails( lines.join( QLatin1Char( '\n' ) ) );
+    ui->detailsWidget->show();
+
+    m_logButton->setEnabled( false );
 }
 

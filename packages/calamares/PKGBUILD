# Maintainer: MotherSphere <linhajahad@gmail.com>
# Based on the AUR package by Rustmilian <Rustmilian@proton.me>
#
# Calamares is not in Arch's repositories — not in core, extra, multilib, nor in
# chaotic-aur — so Arch Colony packages it. It does not exist upstream, so this does
# not violate ADR-0002. See the 2026-08-20 amendment to ADR-0006 for the standing
# obligation this creates: Calamares is a Qt6/KF6 application and Arch's Qt and KDE
# Frameworks updates will periodically break it, each time requiring a rebuild here
# before an ISO can be produced again.

pkgname=calamares
pkgver=3.4.2
pkgrel=4
pkgdesc='Distribution-independent installer framework'
arch=('x86_64')
url='https://codeberg.org/Calamares/calamares'
license=('GPL-3.0-or-later')
depends=(
	'kcoreaddons'
	'kpmcore'
	'libpwquality'
	'qt6-declarative'
	'qt6-svg'
	'yaml-cpp'
	# libcalamares.so links against libpython (readelf: NEEDED libpython3.14.so.1.0)
	# and nine of the fifteen exec modules are main.py. None of the six deps above
	# pulls python — verified with pactree. Without this, `pacman -S calamares` from
	# [colony] installs a binary that dies on "error while loading shared libraries".
	# It only worked on the ISO by accident, because archinstall and reflector happen
	# to pull python in.
	'python'
	# the package installs into usr/share/icons/hicolor/
	'hicolor-icon-theme'
)
makedepends=(
	'cmake'
	'extra-cmake-modules'
	'libglvnd'
	'ninja'
	'qt6-tools'
	'qt6-translations'
)
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
        '0001-netinstall-add-a-search-filter.patch')
sha256sums=('733bbbb00dc9f84874bd5c22960952f317ea2537565431179fa2152b2fbfdccc'
            'SKIP')

prepare() {
	cd "$pkgname-$pkgver"
	# A downstream patch, carried only until upstream decides. netinstall has no
	# search, which is fine for the ten-to-thirty curated entries every other
	# distribution puts in it — and unusable for the >15000 packages Arch Colony
	# offers, which is what archinstall presents and what this distribution is
	# expected to match. Adds a QSortFilterProxyModel with recursive filtering
	# and a search box; 48 lines.
	#
	# To be proposed to Calamares upstream. If it lands, delete this and the
	# patch file — a downstream patch is only ever worth carrying while the
	# upstream conversation is open.
	patch -p1 -i "$srcdir/0001-netinstall-add-a-search-filter.patch"
}

build() {
	# Modules for other init systems, other initramfs generators, and the demo
	# modules. Arch Colony is systemd + mkinitcpio, and the mkinitcpio module is
	# deliberately NOT skipped.
	local _skip_modules=(
		dracut
		dracutlukscfg
		dummycpp
		dummyprocess
		dummypython
		dummypythonqt
		initramfs
		initramfscfg
		interactiveterminal
		services-openrc
	)

	local _cmake_options=(
		-B build
		-S "$srcdir/$pkgname-$pkgver"
		-G Ninja
		-DCMAKE_BUILD_TYPE=Release
		-DCMAKE_INSTALL_PREFIX='/usr'
		-DCMAKE_INSTALL_LIBDIR='lib'
		-DWITH_QT6=ON
		-DINSTALL_CONFIG=ON
		-DSKIP_MODULES="${_skip_modules[*]}"
		-DBUILD_TESTING=OFF
		-DKDE_INSTALL_SYSCONFDIR=/etc
		-Wno-dev
	)

	cmake "${_cmake_options[@]}"
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

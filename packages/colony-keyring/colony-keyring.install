post_upgrade() {
	if usr/bin/pacman-key -l >/dev/null 2>&1; then
		usr/bin/pacman-key --populate colony
	fi
}

post_install() {
	post_upgrade
}

pre_remove() {
	# Drop the keys from pacman's trust store, otherwise removing the package
	# leaves the machine trusting a keyring it no longer has.
	if usr/bin/pacman-key -l >/dev/null 2>&1; then
		local key
		while read -r key _; do
			usr/bin/pacman-key --delete "${key%%:*}" 2>/dev/null || true
		done < usr/share/pacman/keyrings/colony-trusted
	fi
}

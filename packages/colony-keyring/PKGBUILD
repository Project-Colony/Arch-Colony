# Maintainer: MotherSphere <linhajahad@gmail.com>

pkgname=colony-keyring
pkgver=20260819
pkgrel=1
pkgdesc='Arch Colony PGP keyring'
arch=('any')
url='https://github.com/Project-Colony/Arch-Colony'
license=('GPL-3.0-or-later')
install="$pkgname.install"
source=('colony.gpg'
        'colony-trusted'
        'colony-revoked')
# Regenerated by repo/genkey.sh rather than fetched, so there is no upstream digest
# to pin against.
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
	install -Dm644 colony.gpg     "$pkgdir/usr/share/pacman/keyrings/colony.gpg"
	install -Dm644 colony-trusted "$pkgdir/usr/share/pacman/keyrings/colony-trusted"
	install -Dm644 colony-revoked "$pkgdir/usr/share/pacman/keyrings/colony-revoked"
}
